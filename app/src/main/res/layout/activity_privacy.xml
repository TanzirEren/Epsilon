<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/blob_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <View
            android:id="@+id/blob1"
            android:layout_width="340dp"
            android:layout_height="340dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="-130dp"
            android:background="@drawable/blob_violet" />

        <View
            android:id="@+id/blob2"
            android:layout_width="380dp"
            android:layout_height="380dp"
            android:layout_gravity="center_vertical|start"
            android:layout_marginStart="-170dp"
            android:background="@drawable/blob_blue" />

        <View
            android:id="@+id/blob3"
            android:layout_width="320dp"
            android:layout_height="320dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="-100dp"
            android:layout_marginBottom="-60dp"
            android:background="@drawable/blob_pink" />
    </FrameLayout>

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingEnd="20dp"
            android:paddingBottom="28dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/btn_back"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="@drawable/glass_pill"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:contentDescription="Back"
                        android:src="@drawable/ic_back" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:fontFamily="sans-serif-black"
                    android:text="@string/privacy_title"
                    android:textColor="@color/ink"
                    android:textSize="24sp" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/glass_card"
                android:padding="6dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:background="@drawable/img_round"
                    android:clipToOutline="true"
                    android:contentDescription="@string/privacy_title"
                    android:scaleType="centerCrop"
                    android:src="@drawable/banner_privacy" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/glass_card"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/privacy_heading"
                    android:textColor="@color/ink"
                    android:textSize="17sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:letterSpacing="0.2"
                    android:text="@string/privacy_tag"
                    android:textColor="@color/accent"
                    android:textSize="11sp" />

                <LinearLayout
                    android:id="@+id/privacy_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/glass_card"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingMultiplier="1.15"
                    android:text="@string/privacy_accept"
                    android:textColor="@color/ink"
                    android:textSize="14.5sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/mission_slogan"
                    android:textColor="@color/accent"
                    android:textSize="14.5sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center"
                android:text="@string/privacy_footer"
                android:textColor="@color/ink_soft"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
